{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@mcsl/*": ["./.mcsl/*"],
      "@pages/*": ["./.mcsl/support/pages/*"],
      "@helpers/*": ["./.mcsl/support/helpers/*"],
      "@setup/*": ["./.mcsl/support/setup/*"],
      "support/*": ["./.mcsl/support/*"],
      "testData/*": ["./.mcsl/testData/*"],
      "utils/*": ["./.mcsl/utils/*"]
    }
  },
  "include": ["playwright.config.ts", "flows/**/*.ts"]
}
